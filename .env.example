VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# URL usada por el frontend para la caja/agente local (sin secretos)
VITE_SIAT_AGENT_URL=http://127.0.0.1:4737

# Solo proceso Node del agente local. Nunca usar prefijo VITE_ en estos valores.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SIAT_AGENT_CODE=
SIAT_AGENT_SHARED_SECRET=
SIAT_AGENT_STORAGE_KEY=
SIAT_AGENT_DEFAULT_EVENT_CODE=
SIAT_AGENT_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Edge Functions SIAT piloto. Configurar solo como secretos del proyecto, nunca con VITE_.
SIAT_TOKEN_DELEGADO=
SIAT_PRIVATE_KEY_PEM=
SIAT_CERTIFICATE_PEM=
SIAT_CODIGOS_URL=https://pilotosiatservicios.impuestos.gob.bo/v2/FacturacionCodigos
SIAT_SINCRONIZACION_URL=https://pilotosiatservicios.impuestos.gob.bo/v2/FacturacionSincronizacion
SIAT_OPERACIONES_URL=https://pilotosiatservicios.impuestos.gob.bo/v2/FacturacionOperaciones
